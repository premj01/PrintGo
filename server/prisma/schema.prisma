generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// ═══════════════════════════════════════════════════════════════════════════════
// NoAuthUser — anonymous print session (one per file upload)
// ═══════════════════════════════════════════════════════════════════════════════

model NoAuthUser {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Session & Kiosk identification
  userSessionNumber String
  kioskId           String

  // File information
  fileName String?

  // File lifecycle tracking
  s3UploadStatus      String? @default("pending")   // pending | uploaded | failed
  kioskDownloadStatus String? @default("pending")    // pending | requested | downloading | downloaded | failed

  // Print configuration (JSON object)
  // Expected shape:
  // {
  //   copies: 1,
  //   printer: null,
  //   orientation: "portrait",
  //   paperSize: "A4",
  //   sides: "one-sided",
  //   pageRanges: null,
  //   fitToPage: true,
  //   colorMode: "color"
  // }
  fileConfig Json? @default("{}")

  // UPI Payment transaction data
  paymentStatus    String?   @default("pending") // pending | order_created | success | failed | refunded
  transactionId    String?   @unique
  paymentAmount    Float?
  paymentMethod    String?   @default("Razorpay")
  paymentTimestamp DateTime?
  merchantOrderId  String?
  payerVpa         String? // UPI VPA e.g. user@upi

  // Razorpay-specific fields
  razorpayOrderId   String?
  razorpayPaymentId String?
  razorpaySignature String?

  // Refund tracking
  refundId        String?
  refundAmount    Float?
  refundStatus    String?   // null | processed | failed
  refundTimestamp  DateTime?

  // Print status tracking
  printStatus    String?   @default("pending") // pending | printing | success | failed
  isPrintStarted Boolean   @default(false)     // true when print command dispatched after payment
  isPrinted      Boolean   @default(false)     // true when kiosk confirms print completed
  printedAt      DateTime?

  @@index([userSessionNumber])
  @@index([kioskId])
  @@index([transactionId])
  @@index([razorpayOrderId])
}